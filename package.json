{
  "name": "quiz-maker-obsidian-edition",
  "version": "2.0.0",
  "private": true,
  "description": "Make readable quizzes from Obsidian notes and study with focused practice.",
  "main": "main.js",
  "author": "Yerkebulan Abenov",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs src manifest.json versions.json LICENSE --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node scripts/test.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "html-to-image": "1.11.13",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.15.2"
  },
  "overrides": {
    "moment": "2.31.0",
    "minimatch": "$minimatch"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "markdown-it": "15.0.3",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "minimatch": "11.0.1"
  }
}
