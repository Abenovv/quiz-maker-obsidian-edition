    "verify:release": "node scripts/verify-release.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "markdown-it": "15.0.3",
    "obsidian": "1.14.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
