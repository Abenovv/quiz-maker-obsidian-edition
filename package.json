{
  "name": "quiz-maker-obsidian-edition",
  "version": "1.2.3",
  "private": true,
  "description": "Make readable quizzes from Obsidian notes and study with focused practice.",
  "main": "main.js",
  "author": "Yerkebulan Abenov",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
